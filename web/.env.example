# #24 web (Vite) env. Copy to web/.env.local. All client vars are VITE_-prefixed.
# The GraphQL API origin (the fixed API port). The SSE feed is a sibling path (/sse).
VITE_API_URL=http://localhost:41990/graphql
# Network label shown in the header pill: "Local" (anvil) or "Fuji".
VITE_CHAIN_LABEL=Local
# #25 the target chain id for wallet ensureChain: local anvil 0x7a69, Fuji 0xa869.
VITE_CHAIN_ID=0x7a69
# #25 explorer base for tx links (Fuji only; suppressed for local).
VITE_EXPLORER_URL=https://testnet.snowtrace.io
# #24 the demo holder the position dashboard reads before a wallet connects (a seeded identity).
VITE_DEMO_HOLDER=0x70997970c51812dc3a010c7d01b50e0d17dc79c8
